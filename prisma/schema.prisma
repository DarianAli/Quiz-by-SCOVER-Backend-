// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — LMS Quiz Platform
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STUDENT
  TENTOR
}

enum ClassProgram {
  UTBK
  SKD
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// Apakah quiz bisa diulang
enum RetakePolicy {
  ONCE // Hanya sekali
  LIMITED // Terbatas (lihat max_attempts di quiz)
  UNLIMITED // Bebas berulang
}

enum ActivityAction {
  STARTED_QUIZ
  COMPLETED_QUIZ
  REVIEWED_QUIZ
}

// ─── Models ──────────────────────────────────────────────────────────────────

model admin {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  username     String   @unique
  password     String
  email        String   @unique
  phone_number String   @default("")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("admins")
}

model user {
  id                  Int       @id @default(autoincrement())
  uuid                String    @unique @default(uuid())
  userName            String    @unique
  password            String
  full_name           String    @default("")
  email               String    @unique
  role                Role      @default(STUDENT)
  phone_number        String    @default("")
  parent_full_name    String    @default("")
  parent_phone_number String    @default("")
  photoProfile        String    @default("")
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime? // soft delete

  class   classes? @relation(fields: [classId], references: [id])
  classId Int?

  scores       scores[]
  answers      answers[]
  attempts     attempt[]
  activityLogs activity_log[]
  streak       user_streak?

  @@index([classId])
  @@index([email])
  @@index([deleted_at])
  @@map("users")
}

model classes {
  id            Int           @id @default(autoincrement())
  uuid          String        @unique @default(uuid())
  class_name    String
  class_program ClassProgram?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  users        user[]
  subjectClass subjectClass[]

  @@map("classes")
}

model subject {
  id                 Int       @id @default(autoincrement())
  uuid               String    @unique @default(uuid())
  subject_name       String    @unique
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime? // soft delete
  annual_quiz_target Int? // target jumlah quiz per tahun

  subjectClass subjectClass[]
  quizzes      quiz[]

  @@index([deleted_at])
  @@map("subjects")
}

model subjectClass {
  subjectId Int
  classId   Int

  subject subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   classes @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([subjectId, classId])
  @@map("subject_classes")
}

model quiz {
  id         Int        @id @default(autoincrement())
  uuid       String     @unique @default(uuid())
  quiz_title String
  quiz_date  DateTime   @default(now())
  duration   Int        @default(30) // minutes
  status     QuizStatus @default(DRAFT)
  difficulty Difficulty @default(EASY)

  /// Apakah quiz ini boleh dikerjakan ulang
  retake_policy RetakePolicy @default(ONCE)
  /// Jika LIMITED: berapa kali maksimum (null = ONCE / UNLIMITED)
  max_attempts  Int?

  created_by   Int? // bisa userId atau adminId
  creator_role Role?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime? // soft delete

  subject   subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId Int?

  scores       scores[]
  answers      answers[]
  questions    questions[]
  attempts     attempt[]
  activityLogs activity_log[]

  @@index([subjectId])
  @@index([deleted_at])
  @@map("quizzes")
}

model attempt {
  id             Int @id @default(autoincrement())
  attempt_number Int @default(1) // urutan attempt ke berapa untuk user + quiz ini
  userId         Int
  quizId         Int

  start_time    DateTime  @default(now())
  finished_time DateTime?
  isFinished    Boolean   @default(false)
  created_at    DateTime  @default(now())

  user user @relation(fields: [userId], references: [id])
  quiz quiz @relation(fields: [quizId], references: [id])

  score scores? // relasi 1-to-1 ke scores (setelah submit)

  @@index([userId, quizId])
  @@map("attempts")
}

model scores {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  total_questions Int      @default(0)
  correct         Int      @default(0)
  wrong           Int      @default(0)
  skipped         Int      @default(0)
  score           Int      @default(0) // 0-100
  accuracy        Float    @default(0) // percentage
  xp_earned       Int      @default(0)
  start_time      DateTime
  finished_time   DateTime
  duration_used   Int      @default(0) // actual minutes used
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user      user    @relation(fields: [userId], references: [id])
  userId    Int
  quiz      quiz    @relation(fields: [quizId], references: [id])
  quizId    Int
  attempt   attempt @relation(fields: [attemptId], references: [id])
  attemptId Int     @unique // 1 attempt = 1 score

  @@index([userId])
  @@index([quizId])
  @@index([userId, quizId])
  @@map("scores")
}

model answers {
  id          Int      @id @default(autoincrement())
  attemptId   Int // jawaban terikat ke attempt tertentu
  quizId      Int
  userId      Int
  questionsId Int
  optionsId   Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  quiz      quiz      @relation(fields: [quizId], references: [id])
  user      user      @relation(fields: [userId], references: [id])
  questions questions @relation(fields: [questionsId], references: [id])
  options   options   @relation(fields: [optionsId], references: [id])

  // Satu jawaban per soal per attempt
  @@unique([attemptId, questionsId])
  @@index([userId, quizId])
  @@map("answers")
}

model questions {
  id             Int        @id @default(autoincrement())
  uuid           String     @unique @default(uuid())
  question_text  String     @db.Text
  question_image String     @default("")
  discussion     String     @default("") @db.Text // Pembahasan / explanasi
  difficulty     Difficulty @default(EASY)
  poin           Int        @default(10)
  order_index    Int        @default(0) // urutan soal dalam quiz
  deleted_at     DateTime?

  quizId Int
  quiz   quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  options options[]
  answers answers[]

  @@index([quizId])
  @@index([deleted_at])
  @@map("questions")
}

model options {
  id           Int     @id @default(autoincrement())
  uuid         String  @unique @default(uuid())
  option_text  String  @db.Text
  option_image String  @default("")
  is_correct   Boolean @default(false)
  order_index  Int     @default(0)

  questionsId Int
  questions   questions @relation(fields: [questionsId], references: [id], onDelete: Cascade)

  answers answers[]

  @@index([questionsId])
  @@map("options")
}

/// Log aktivitas student (untuk dashboard & activity feed)
model activity_log {
  id         Int            @id @default(autoincrement())
  userId     Int
  quizId     Int
  action     ActivityAction
  score      Int? // null jika bukan COMPLETED_QUIZ
  created_at DateTime       @default(now())

  user user @relation(fields: [userId], references: [id])
  quiz quiz @relation(fields: [quizId], references: [id])

  @@index([userId])
  @@index([userId, created_at])
  @@map("activity_logs")
}

/// Tracking streak belajar harian student
model user_streak {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  current_streak Int      @default(0)
  longest_streak Int      @default(0)
  last_activity  DateTime @default(now())
  updated_at     DateTime @updatedAt

  user user @relation(fields: [userId], references: [id])

  @@map("user_streaks")
}
